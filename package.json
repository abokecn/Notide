{
  "name": "notide",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "tauri": "tauri",
    "dev": "vite",
    "build": "vite build",
    "check:size": "node tools/check-bundle-size.mjs web dist --max-total-mib 6 --max-editor-raw-kib 650 --max-editor-gzip-kib 220 --max-preview-raw-kib 250 --max-preview-gzip-kib 90",
    "deploy:worker": "wrangler deploy",
    "preview": "vite preview",
    "test:unit": "node --test tests/*.test.mjs",
    "native:dev": "tauri dev",
    "native:build": "tauri build",
    "native:android:init": "tauri android init",
    "native:android": "tauri android build --ci --debug --apk",
    "native:android:release": "tauri android build --ci --apk --aab",
    "r2:migrate": "powershell -ExecutionPolicy Bypass -File tools/migrate-r2-notes.ps1"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.9",
    "@lezer/markdown": "^1.7.2",
    "@tauri-apps/api": "latest",
    "dompurify": "latest",
    "highlight.js": "latest",
    "katex": "latest",
    "markdown-it": "latest",
    "markdown-it-container": "latest",
    "markdown-it-deflist": "latest",
    "markdown-it-footnote": "latest",
    "markdown-it-ins": "latest",
    "markdown-it-mark": "latest",
    "markdown-it-multimd-table": "latest",
    "markdown-it-sub": "latest",
    "markdown-it-sup": "latest",
    "markdown-it-task-lists": "latest",
    "mermaid": "latest",
    "vue": "latest",
    "yaml": "latest"
  },
  "devDependencies": {
    "@tauri-apps/cli": "latest",
    "@vitejs/plugin-vue": "latest",
    "vite": "latest",
    "wrangler": "4.32.0"
  }
}
