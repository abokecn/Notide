{
  "name": "notide",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "tauri": "tauri",
    "dev": "vite",
    "build": "vite build",
    "check:size": "node tools/check-bundle-size.mjs web dist --max-total-mib 6 --max-editor-raw-kib 650 --max-editor-gzip-kib 220 --max-preview-raw-kib 250 --max-preview-gzip-kib 90",
    "deploy:worker": "wrangler deploy",
    "preview": "vite preview",
    "test:unit": "node --test tests/*.test.mjs",
    "native:dev": "tauri dev",
    "native:build": "tauri build",
    "native:android:init": "tauri android init",
    "native:android": "tauri android build --ci --debug --apk",
    "native:android:release": "tauri android build --ci --apk --aab",
    "native:android:prepare": "node tools/prepare-android-project.mjs",
    "native:android:signing": "node tools/configure-android-release.mjs",
    "release:check-version": "node tools/verify-release-version.mjs",
    "release:manifest": "node tools/create-update-manifest.mjs",
    "r2:migrate": "powershell -ExecutionPolicy Bypass -File tools/migrate-r2-notes.ps1"
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.20.3",
    "@codemirror/commands": "6.11.0",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/language": "6.12.4",
    "@codemirror/search": "6.7.1",
    "@codemirror/state": "6.7.1",
    "@codemirror/view": "6.43.9",
    "@lezer/markdown": "1.7.2",
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/plugin-fs": "2.5.1",
    "@tauri-apps/plugin-opener": "2.5.4",
    "@tauri-apps/plugin-os": "2.3.2",
    "@tauri-apps/plugin-process": "2.3.1",
    "@tauri-apps/plugin-updater": "2.10.1",
    "dompurify": "3.4.13",
    "highlight.js": "11.12.0",
    "katex": "0.18.4",
    "markdown-it": "15.0.0",
    "markdown-it-container": "4.0.0",
    "markdown-it-deflist": "4.0.0",
    "markdown-it-footnote": "4.0.0",
    "markdown-it-ins": "4.0.0",
    "markdown-it-mark": "4.0.0",
    "markdown-it-multimd-table": "4.2.3",
    "markdown-it-sub": "2.0.0",
    "markdown-it-sup": "2.0.0",
    "markdown-it-task-lists": "2.1.1",
    "mermaid": "11.16.1",
    "vue": "3.5.41",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.11.4",
    "@vitejs/plugin-vue": "6.0.8",
    "vite": "8.2.1",
    "wrangler": "4.120.0"
  }
}
