{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Notide",
  "version": "0.1.0",
  "identifier": "com.abokecn.notide",
  "build": {
    "beforeDevCommand": "npm run dev -- --host 127.0.0.1 --port 4173",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:4173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Notide",
        "width": 1280,
        "height": 820,
        "minWidth": 920,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": false,
    "windows": {
      "webviewInstallMode": { "type": "embedBootstrapper" }
    }
  }
}
